# Copy this to .env and fill in your values
# cp .env.example .env

# ── Required for speaker diarization ──────────────────────────────
# Get from https://huggingface.co/settings/tokens
# Accept model terms at:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/segmentation-3.0
HF_TOKEN=hf_your_token_here

# ── Optional: Claude action item extraction ───────────────────────
# Used by speech-api to extract action items with Claude.
# If not set (or the call fails), falls back to regex-based extraction.
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

# ── Speech API config ─────────────────────────────────────────────
DEFAULT_MODEL=base
TRANSCRIPTION_MODEL_NAMES=tiny,base,small,medium,large-v3
SPEECH_API_PORT=8000

# ── App API config ────────────────────────────────────────────────
APP_API_PORT=5001
MAX_UPLOAD_BYTES=209715200
MAX_MEDIA_DURATION_SECONDS=10800
